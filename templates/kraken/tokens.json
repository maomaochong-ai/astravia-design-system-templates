        "fontFamily": "Kraken-Product",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": "1.33",
        "letterSpacing": 0
      },
      "$type": "typography",
      "$description": "Typography style for small."
    },
    "micro": {
      "$value": {
        "fontFamily": "Kraken-Product",
        "fontSize": "7px",
        "fontWeight": 500,
        "lineHeight": "1.00",
        "letterSpacing": 0
      },
      "$type": "typography",
      "$description": "Typography style for micro."
    }
  },
  "spacing": {
    "4": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Spacing step 4."
    },
    "8": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Spacing step 8."
    },
    "12": {
      "$value": "12px",
