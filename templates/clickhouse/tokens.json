      "$description": "Use for the ink role."
    },
    "body": {
      "$value": "#cccccc",
      "$type": "color",
      "$description": "Use for the body role."
    },
    "body-strong": {
      "$value": "#e6e6e6",
      "$type": "color",
      "$description": "Use for the body strong role."
    },
    "muted": {
      "$value": "#888888",
