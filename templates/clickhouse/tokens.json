    },
    "on-yellow": {
      "$value": "#0a0a0a",
      "$type": "color",
      "$description": "Use for the on yellow role."
    },
    "accent-emerald": {
      "$value": "#22c55e",
      "$type": "color",
      "$description": "Use for the accent emerald role."
    },
    "accent-rose": {
      "$value": "#ef4444",
      "$type": "color",
      "$description": "Use for the accent rose role."
    },
    "accent-blue": {
      "$value": "#3b82f6",
      "$type": "color",
