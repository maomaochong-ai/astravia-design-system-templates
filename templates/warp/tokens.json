    "xxs": {
      "$value": "1px",
      "$type": "dimension",
      "$description": "Border radius xxs."
    },
    "xs": {
      "$value": "2px",
      "$type": "dimension",
      "$description": "Border radius xs."
    },
    "sm": {
      "$value": "3px",
      "$type": "dimension",
      "$description": "Border radius sm."
    },
    "md": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Border radius md."
    },
    "lg": {
      "$value": "6px",
      "$type": "dimension",
      "$description": "Border radius lg."
    },
    "pill": {
      "$value": "9999px",
      "$type": "dimension",
