    },
    "lg": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Spacing step lg."
    },
    "xl": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "Spacing step xl."
    },
    "2xl": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Spacing step 2xl."
    },
    "3xl": {
      "$value": "48px",
      "$type": "dimension",
      "$description": "Spacing step 3xl."
    },
    "4xl": {
      "$value": "64px",
      "$type": "dimension",
      "$description": "Spacing step 4xl."
    },
    "5xl": {
      "$value": "96px",
      "$type": "dimension",
      "$description": "Spacing step 5xl."
