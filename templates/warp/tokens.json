        "fontWeight": 500,
        "lineHeight": "24px",
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "Typography style for body md strong."
    },
    "body-sm": {
      "$value": {
        "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": "20px",
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "Typography style for body sm."
    },
    "body-sm-strong": {
      "$value": {
        "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
        "fontSize": "14px",
        "fontWeight": 500,
        "lineHeight": "20px",
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "Typography style for body sm strong."
