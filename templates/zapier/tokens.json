        "lineHeight": "56px",
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "Typography style for display xl."
    },
    "display-lg": {
      "$value": {
        "fontFamily": "Degular Display, Inter, system-ui, sans-serif",
